  "repository": "https://github.com/aaversee/lume",
  "type": "module",
  "private": true,
  "scripts": {
    "validate": "cd server && npx tsc --noEmit && cd ../client && npx tsc --noEmit",
    "validate:server": "cd server && npx tsc --noEmit",
    "validate:client": "cd client && npx tsc --noEmit",
    "test": "npm --prefix server test && npm --prefix client test",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:css": "node scripts/check-css-vars.mjs"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
